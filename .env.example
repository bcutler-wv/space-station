# Run `node scripts/init-env.mjs` to create .env with new bootstrap secrets.
# Or copy this file and fill in both secrets and the deployment settings below.
# scripts/init-env.mjs also creates the private .cache/go-camo.env image signing key.
# The current owner setup flow does not configure a hostname, proxy, or provider accounts.

POSTGRES_PASSWORD=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Back this up. Without it, stored credentials cannot be decrypted.
STATION_MASTER_KEY=

# Port the app container listens on (point your reverse proxy here)
APP_PORT=8080

# Exact HTTPS browser origin. The init script creates a localhost certificate for disposable development.
APP_ORIGIN=https://station.example.com

# Set both paths for direct TLS, or leave blank behind an HTTPS reverse proxy.
APP_TLS_KEY_PATH=
APP_TLS_CERT_PATH=

# Exact IP of the HTTPS reverse proxy when TLS terminates before the app.
APP_TRUSTED_PROXY_IP=

# Non-root container UID/GID that can read a private direct-TLS key bind mount.
APP_UID=1000
APP_GID=1000
