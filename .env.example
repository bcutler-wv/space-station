# Run `node scripts/init-env.mjs` to create .env with new bootstrap secrets.
# Or copy this file and fill in both secrets. Everything else is configured in the setup wizard.

POSTGRES_PASSWORD=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Back this up. Without it, stored credentials cannot be decrypted.
STATION_MASTER_KEY=

# Port the app container listens on (point your reverse proxy here)
APP_PORT=8080
