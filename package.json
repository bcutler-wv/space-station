{
  "name": "station",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "build": "tsc -b && corepack pnpm --filter @station/web build",
    "test:e2e": "playwright test",
    "check:colors": "node scripts/check-colors.mjs",
    "check:licenses": "corepack pnpm licenses list --json | node scripts/check-licenses.mjs",
    "check": "corepack pnpm --filter @station/search check:parser && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm check:colors && corepack pnpm check:licenses"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opensearch-project/opensearch": "3.9.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.30",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "otplib": "13.5.0",
    "prettier": "3.9.10",
    "spdx-expression-parse": "5.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
